{
  "name": "@moderation/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint src --ext .ts",
    "test": "pnpm build && node --test test/*.spec.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.723.0",
    "@moderation/database": "workspace:*",
    "@moderation/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "@nestjs/core": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/multer": "^1.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
