{
  "name": "image-moderation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @moderation/database generate",
    "db:migrate": "pnpm --filter @moderation/database migrate"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.1",
    "typescript": "^5.7.3"
  }
}
