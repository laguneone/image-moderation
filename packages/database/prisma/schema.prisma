generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum StageStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewAction {
  APPROVED
  REJECTED
}

enum ConfigStatus {
  DRAFT
  TESTING
  ACTIVE
  ARCHIVED
}

model ModerationJob {
  id             String           @id @default(cuid())
  applicationId  String           @map("application_id") @db.VarChar(64)
  imageAssetId   String           @map("image_asset_id")
  status         ModerationStatus @default(QUEUED)
  pipeline       String           @default("interior-default") @db.VarChar(100)
  pipelineVersionId String?        @map("pipeline_version_id")
  pipelineVersion PipelineVersion? @relation(fields: [pipelineVersionId], references: [id], onDelete: Restrict)
  context        Json             @default("{}") @db.JsonB
  idempotencyKey String?          @unique @map("idempotency_key") @db.VarChar(128)
  errorCode      String?          @map("error_code") @db.VarChar(100)
  effectiveDecision String?       @map("effective_decision") @db.VarChar(32)
  reviewAssigneeId  String?       @map("review_assignee_id") @db.VarChar(64)
  reviewClaimedAt   DateTime?     @map("review_claimed_at")
  reviewVersion     Int           @default(0) @map("review_version")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  imageAsset     ImageAsset       @relation(fields: [imageAssetId], references: [id], onDelete: Restrict)
  results        ModerationResult[]
  stageExecutions StageExecution[]
  invocations    ModelInvocation[]
  reviewDecisions ReviewDecision[]
  auditLogs      AuditLog[]

  @@index([applicationId, createdAt])
  @@index([status, createdAt])
  @@map("moderation_jobs")
}

model ImageAsset {
  id           String          @id @default(cuid())
  sha256       String          @unique @db.Char(64)
  objectKey    String          @unique @map("object_key") @db.VarChar(512)
  mimeType     String          @map("mime_type") @db.VarChar(100)
  originalName String?         @map("original_name") @db.VarChar(255)
  sizeBytes    BigInt          @map("size_bytes")
  width        Int
  height       Int
  frameCount   Int             @default(1) @map("frame_count")
  createdAt    DateTime        @default(now()) @map("created_at")
  jobs         ModerationJob[]

  @@index([createdAt])
  @@map("image_assets")
}

model ModerationResult {
  id                    String        @id @default(cuid())
  jobId                 String        @map("job_id")
  job                   ModerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  nsfwRiskScore         Int           @map("nsfw_risk_score")
  domainMismatchScore   Int           @map("domain_mismatch_score")
  confidence            Float?
  decision              String        @db.VarChar(32)
  criticalFlags         Json          @default("[]") @map("critical_flags") @db.JsonB
  reasons               Json          @default("[]") @db.JsonB
  payload               Json          @db.JsonB
  createdAt             DateTime      @default(now()) @map("created_at")

  @@index([jobId, createdAt])
  @@map("moderation_results")
}

model StageExecution {
  id                String        @id @default(cuid())
  jobId             String        @map("job_id")
  job               ModerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageType         String        @map("stage_type") @db.VarChar(64)
  status            StageStatus
  startedAt         DateTime      @default(now()) @map("started_at")
  completedAt       DateTime?     @map("completed_at")
  durationMs        Int?          @map("duration_ms")
  modelId           String?       @map("model_id") @db.VarChar(200)
  promptVersionId   String?       @map("prompt_version_id") @db.VarChar(64)
  normalizedOutput  Json?         @map("normalized_output") @db.JsonB
  error             String?       @db.Text
  invocations       ModelInvocation[]

  @@index([jobId, startedAt])
  @@map("stage_executions")
}

model ModelInvocation {
  id               String         @id @default(cuid())
  jobId            String         @map("job_id")
  job              ModerationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageExecutionId String?        @map("stage_execution_id")
  stageExecution   StageExecution? @relation(fields: [stageExecutionId], references: [id], onDelete: SetNull)
  modelId          String         @map("model_id") @db.VarChar(200)
  provider         String?        @db.VarChar(100)
  requestId        String?        @map("request_id") @db.VarChar(200)
  inputTokens      Int?           @map("input_tokens")
  outputTokens     Int?           @map("output_tokens")
  costUsd          Decimal?       @map("cost_usd") @db.Decimal(18, 10)
  latencyMs        Int            @map("latency_ms")
  status           StageStatus
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([jobId, createdAt])
  @@map("model_invocations")
}

model ReviewDecision {
  id             String        @id @default(cuid())
  jobId          String        @map("job_id")
  job            ModerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId        String        @map("actor_id") @db.VarChar(64)
  action         ReviewAction
  rejectionReason String?      @map("rejection_reason") @db.VarChar(64)
  comment        String?       @db.Text
  reviewVersion  Int           @map("review_version")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([jobId, createdAt])
  @@map("review_decisions")
}

model AuditLog {
  id         String         @id @default(cuid())
  jobId      String?        @map("job_id")
  job        ModerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  actorId    String?        @map("actor_id") @db.VarChar(64)
  action     String         @db.VarChar(100)
  entityType String         @map("entity_type") @db.VarChar(64)
  entityId   String         @map("entity_id") @db.VarChar(100)
  before     Json?          @db.JsonB
  after      Json?          @db.JsonB
  metadata   Json           @default("{}") @db.JsonB
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([jobId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model ModelConfiguration {
  id                String       @id @default(cuid())
  key               String       @db.VarChar(64)
  version           Int
  name              String       @db.VarChar(120)
  role              String       @db.VarChar(64)
  openRouterModelId String       @map("openrouter_model_id") @db.VarChar(200)
  status            ConfigStatus @default(DRAFT)
  inputModalities   String[]     @default(["image", "text"]) @map("input_modalities")
  structuredOutput  Boolean      @default(false) @map("structured_output")
  generationParams  Json         @default("{}") @map("generation_params") @db.JsonB
  timeoutMs         Int          @default(90000) @map("timeout_ms")
  maxTokens         Int?         @map("max_tokens")
  maxCostUsd        Decimal?     @map("max_cost_usd") @db.Decimal(12, 6)
  fallbackModelId   String?      @map("fallback_model_id") @db.VarChar(200)
  createdBy         String?      @map("created_by") @db.VarChar(64)
  createdAt         DateTime     @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([key, status])
  @@map("model_configurations")
}

model PromptTemplate {
  id        String          @id @default(cuid())
  key       String          @unique @db.VarChar(64)
  name      String          @db.VarChar(120)
  versions  PromptVersion[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("prompt_templates")
}

model PromptVersion {
  id         String       @id @default(cuid())
  templateId String       @map("template_id")
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  modelRole  String       @map("model_role") @db.VarChar(64)
  content    String       @db.Text
  status     ConfigStatus @default(DRAFT)
  createdBy  String?      @map("created_by") @db.VarChar(64)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("prompt_versions")
}

model PipelineVersion {
  id            String       @id @default(cuid())
  pipelineKey   String       @map("pipeline_key") @db.VarChar(100)
  version       Int
  name          String       @db.VarChar(120)
  status        ConfigStatus @default(DRAFT)
  configuration Json         @default("{}") @db.JsonB
  createdBy     String?      @map("created_by") @db.VarChar(64)
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  jobs          ModerationJob[]

  @@unique([pipelineKey, version])
  @@index([pipelineKey, status])
  @@map("pipeline_versions")
}

model RuleVersion {
  id             String       @id @default(cuid())
  key            String       @db.VarChar(64)
  version        Int
  name           String       @db.VarChar(120)
  description    String?      @db.Text
  enabled        Boolean      @default(true)
  priority       Int          @default(100)
  conditions     Json         @db.JsonB
  actions        Json         @db.JsonB
  applicationIds String[]     @default([]) @map("application_ids")
  status         ConfigStatus @default(DRAFT)
  createdBy      String?      @map("created_by") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([status, enabled, priority])
  @@map("rule_versions")
}

model ConfigurationAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id") @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(100)
  action     String   @db.VarChar(100)
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("configuration_audit_logs")
}
